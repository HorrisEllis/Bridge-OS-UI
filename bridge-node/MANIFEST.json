{
  "name": "bridge-node",
  "version": "1.2.0",
  "build": "1.2.0-NEXUS",
  "date": "2026-05-01",
  "description": "Bridge OS — Sovereign Node. SISO + Causal + Trust + Mesh + DHT + DDNS.",
  "author": "James Brooks — Erosmancer / SISO Development Co.",
  "axioms": [
    "Local first — all computation attempted locally before any cloud route",
    "Pulse authority — no state change valid unless emitted as immutable bus event",
    "Layer sovereignty — each module has exactly one job, never bleeds into another",
    "Constraint over code — behavior emerges from gates and fields, not conditionals",
    "Causal memory — every bus event ingested into 1M-entry causal ring buffer",
    "Identity is cryptographic — UUID = SHA256(Ed25519 pubKey), unforgeable",
    "Trust is earned — Bayesian per-peer scoring, Sybil-resistant, contradiction-detected",
    "Score alone never blocks — bridge-sngate requires a matching rule to deny"
  ],
  "boot": {
    "entrypoint": "index.js",
    "phases": [
      { "phase": 1,     "name": "identity",   "vital": true,  "module": "bridge-identity",          "desc": "Ed25519 keypair, UUID=SHA256(pubKey), keystore" },
      { "phase": 2,     "name": "core",       "vital": true,  "module": "bridge-core + bridge-appid","desc": "SISO bus, callto registry, node registry, AppID" },
      { "phase": 3,     "name": "IME",        "vital": true,  "module": "bridge-IME",               "desc": "behavioral memory, trust scoring, probationary ramp" },
      { "phase": 4,     "name": "sngate",     "vital": true,  "module": "bridge-sngate",            "desc": "three-state gate (allow/deny/observe), rule introspection" },
      { "phase": 5,     "name": "bus+data",   "vital": true,  "module": "bridge-core/bus + bridge-data", "desc": "SISO bus live, universal intake pipeline" },
      { "phase": 6,     "name": "heartbeat",  "vital": true,  "module": "bridge-heartbeat",         "desc": "BPM tracker, UDP pulse :7777, liveness monitoring" },
      { "phase": 7,     "name": "plugin",     "vital": false, "module": "bridge-plugin",            "desc": "WS gateway for Guardian/Tampermonkey" },
      { "phase": "7b",  "name": "eros",       "vital": false, "module": "eros-shim",                "desc": "ErosmancerOS CDP shim" },
      { "phase": "7c",  "name": "mesh",       "vital": false, "module": "bridge-mesh + trust-mesh", "desc": "ECDH channels, Bayesian peer trust" },
      { "phase": "7d",  "name": "magnet",     "vital": false, "module": "bridge-magnet",            "desc": "nexus:// URI cascade resolution" },
      { "phase": 8,     "name": "causal",     "vital": false, "module": "bridge-causal",            "desc": "causal-nexus v5.0.1, 1M ring buffer, CQL, sigma" },
      { "phase": "9a",  "name": "bayesian",   "vital": false, "module": "bridge-bayesian",          "desc": "Beta belief engine" },
      { "phase": "9b",  "name": "ollama",     "vital": false, "module": "bridge-ollama",            "desc": "Ollama local LLM driver, bus-driven streaming" },
      { "phase": "9c",  "name": "routing",    "vital": false, "module": "bridge-routing",           "desc": "TCP mesh router :3749" },
      { "phase": "9d",  "name": "gateway",    "vital": false, "module": "bridge-gateway",           "desc": "HTTP API gateway :3748, rate limiting, CORS, proxy" },
      { "phase": "9e",  "name": "canvas",     "vital": false, "module": "bridge-canvas",            "desc": "canvas state persistence" },
      { "phase": 10,    "name": "http",       "vital": true,  "module": "unified route table",      "desc": "HTTP server :3747, all routes mounted" }
    ]
  },
  "modules": {
    "bridge-identity":   { "version": "2.0.0", "vital": true,  "status": "complete",   "path": "./bridge-identity/index.js",   "role": "Ed25519 keypair, handshaking, keystore" },
    "bridge-core":       { "version": "2.0.0", "vital": true,  "status": "complete",   "path": "./bridge-core/index.js",       "role": "SISO bus, callto registry, node registry" },
    "bridge-IME":        { "version": "2.0.0", "vital": true,  "status": "complete",   "path": "./bridge-IME/index.js",        "role": "behavioral memory, trust scoring, probationary ramp" },
    "bridge-sngate":     { "version": "2.0.0", "vital": true,  "status": "complete",   "path": "./bridge-sngate/index.js",     "role": "three-state gate, rule introspection, shadow detection" },
    "bridge-data":       { "version": "2.0.0", "vital": true,  "status": "complete",   "path": "./bridge-data/index.js",       "role": "universal intake pipeline" },
    "bridge-heartbeat":  { "version": "2.0.0", "vital": true,  "status": "complete",   "path": "./bridge-heartbeat/index.js",  "role": "BPM tracker, UDP pulse, liveness monitoring" },
    "bridge-contracts":  { "version": "2.0.0", "vital": true,  "status": "complete",   "path": "./bridge-contracts/index.js",  "role": "frozen interface contracts, boot-gate validation" },
    "bridge-appid":      { "version": "1.0.0", "vital": true,  "status": "complete",   "path": "./bridge-appid/index.js",      "role": "AppID registry, nexus:// trust codes, session tokens" },
    "bridge-plugin":     { "version": "2.0.0", "vital": false, "status": "complete",   "path": "./bridge-plugin/gateway/ws-gateway.js", "role": "WS gateway for Guardian/Tampermonkey, rate limiting" },
    "bridge-mesh":       { "version": "2.0.0", "vital": false, "status": "partial",    "path": "./bridge-mesh/index.js",       "role": "ECDH channels, peer discovery, trust-mesh" },
    "bridge-causal":     { "version": "1.0.0", "vital": false, "status": "complete",   "path": "./bridge-causal/index.js",     "role": "causal-nexus v5.0.1 adapter, 1M ring buffer, CQL, sigma" },
    "bridge-dht":        { "version": "1.1.0", "vital": false, "status": "complete",   "path": "./bridge-dht/index.js",        "role": "Kademlia DHT, Ed25519-signed records, Node 22 fix" },
    "bridge-ollama":     { "version": "4.1.0", "vital": false, "status": "integrated", "path": "./bridge-ollama/index.js",     "role": "Ollama local LLM driver, bus-driven streaming" },
    "bridge-cli":        { "version": "2.1.0", "vital": false, "status": "complete",   "path": "./bridge-cli/nexus-cli.js",    "role": "REPL + all commands + dispatch export + module unload" },
    "bridge-gateway":    { "version": "1.0.0", "vital": false, "status": "complete",   "path": "./bridge-gateway/index.js",    "role": "HTTP API gateway :3748, rate limiting, CORS, proxy" },
    "bridge-ddns":       { "version": "1.0.0", "vital": false, "status": "complete",   "path": "./bridge-ddns/index.js",       "role": "DDNS client (Cloudflare/No-IP/DynDNS) + custom DNS server" },
    "bridge-proxy":      { "version": "1.0.0", "vital": false, "status": "complete",   "path": "./bridge-proxy/index.js",      "role": "HTTP/HTTPS reverse proxy with SNI routing" },
    "bridge-ssh":        { "version": "1.1.0", "vital": false, "status": "active",     "path": "./bridge-ssh/index.js",        "role": "persistent SSH transport, session management" },
    "bridge-guardian":   { "version": "4.0.0", "vital": false, "status": "complete",   "path": "./bridge-guardian/handshake.js","role": "Firefox/Chrome extension + server-side handshake layer" },
    "bridge-health":     { "version": "1.0.0", "vital": false, "status": "complete",   "path": "./bridge-health/index.js",     "role": "mesh health score, auto-heal, delta replay, divergence alerts" },
    "bridge-onion":      { "version": "1.0.0", "vital": false, "status": "complete",   "path": "./bridge-onion/index.js",      "role": "multi-hop encrypted circuits, ECDH P-256, AES-256-GCM" },
    "bridge-steg":       { "version": "1.0.0", "vital": false, "status": "complete",   "path": "./bridge-steg/index.js",       "role": "steganographic channels — JSON telemetry + HTTP header covert" },
    "bridge-shaper":     { "version": "1.0.0", "vital": false, "status": "complete",   "path": "./bridge-shaper/index.js",     "role": "traffic shaping — TLS-aligned padding, Gaussian jitter" },
    "bridge-transport":  { "version": "1.0.0", "vital": false, "status": "complete",   "path": "./bridge-transport/index.js",  "role": "unified transport abstraction — HTTP, BLE, cellular" },
    "bridge-mobile":     { "version": "1.0.0", "vital": false, "status": "complete",   "path": "./bridge-mobile/index.js",     "role": "mobile/Pi runtime — power budget, checkpoint, watchdog, installer" },
    "bridge-ipfs":       { "version": "1.0.0", "vital": false, "status": "complete",   "path": "./bridge-ipfs/index.js",       "role": "IPFS CIDv0 content-addressed storage, DHT provider records" },
    "bridge-bayesian":   { "version": "1.0.0", "vital": false, "status": "complete",   "path": "./bridge-bayesian/index.js",   "role": "Beta belief engine, Bayesian trust scoring" },
    "bridge-magnet":     { "version": "1.0.0", "vital": false, "status": "complete",   "path": "./bridge-magnet/index.js",     "role": "nexus:// URI cascade resolution" },
    "module-registry":   { "version": "1.0.0", "vital": false, "status": "complete",   "path": "./bridge-node/module-registry.js", "role": "runtime module load/unload/reload, /module/* routes" }
  },
  "routes": {
    "GET  /health":              "Full system diagnostics — uptime, uuid, causal, trust, appid",
    "GET  /identity":            "Node public record (UUID, public key, group hint)",
    "GET  /runtime/state":       "Live WS gateway state + causal + trust",
    "POST /pulse":               "Node self-registration (CFR, external clients)",
    "GET  /nodes":               "All registered nodes",
    "GET  /calltos":             "Callto registry",
    "POST /callto":              "Execute a browser callto (DOM action)",
    "GET  /magnet/:shortId":     "Resolve nexus:// shortId to address",
    "POST /magnet/resolve":      "Full nexus:// URI cascade resolution",
    "GET  /trust/stats":         "Trust mesh statistics",
    "GET  /trust/score/:uuid":   "Per-peer trust score + snapshot",
    "GET  /ime/profile/:uuid":   "IME behavioral profile for a UUID",
    "GET  /sngate/trace":        "Last 100 SNR gate decisions",
    "GET  /sngate/rules":        "Active gate rules",
    "POST /sngate/rules":        "Add a gate rule",
    "GET  /causal/stats":        "Causal kernel statistics",
    "GET  /causal/classify":     "Sigma regime classification",
    "POST /causal/query":        "CQL query against causal ring",
    "POST /appid/*":             "AppID registry (create, redeem, list)",
    "POST /data/push":           "Universal data intake pipeline",
    "POST /mesh/*":              "Mesh peer operations",
    "GET  /dht/peers":           "DHT routing table",
    "POST /dht/find":            "DHT iterative lookup",
    "GET  /dht/stats":           "DHT statistics",
    "GET  /cfr/*":               "Constraint Field Runtime — nodes, field, deltas, stream",
    "POST /cfr/emit":            "Emit a bus event from HTTP",
    "POST /cfr/simulate":        "Inject CFR simulation event",
    "GET  /guardian/status":     "Connected Guardian instances",
    "POST /guardian/handshake":  "Guardian AppID introduction",
    "POST /guardian/heartbeat":  "Guardian session renewal",
    "POST /guardian/appid/*":    "Guardian AppID management",
    "GET  /module/list":         "All loaded modules + status + uptime",
    "GET  /module/:name":        "Single module diagnostics",
    "POST /module/:name/unload": "Gracefully unload a non-vital module",
    "POST /module/:name/reload": "Stop + re-require + re-init a module",
    "POST /userscript/*":        "Guardian/Tampermonkey WebSocket gateway",
    "POST /cli/command":         "HTTP CLI — execute any CLI command",
    "GET  /gateway/status":      "API gateway diagnostics (port 3748)"
  },
  "ports": {
    "3747":  "HTTP + WebSocket (primary sovereign node)",
    "3748":  "HTTP API gateway (bridge-gateway)",
    "3749":  "TCP mesh router (bridge-routing)",
    "5353":  "DNS server fallback (bridge-ddns, when :53 unavailable)",
    "7777":  "UDP pulse broadcast (bridge-heartbeat LAN discovery)",
    "11434": "Ollama local LLM"
  },
  "cli": {
    "entrypoint": "bridge-cli/nexus-cli.js",
    "usage": "node index.js --cli   OR   node bridge-cli/nexus-cli.js",
    "exports": ["startCLI", "dispatch", "negotiatePort", "scanLAN", "randomEphemeralPort", "BLOCKED_PORTS"],
    "commands": [
      "status", "identity", "nodes", "trust", "ime",
      "sngate trace|rules|add", "causal stats|classify|query|log|recent",
      "cfr nodes|field|deltas|state|simulate|register",
      "emit", "pulse", "calltos", "guardian status|appid",
      "mesh scan|peers|dht|announce", "dht peers|find|stats",
      "module list|<name>|<name> unload|<name> reload",
      "port [set N]", "ollama <prompt>",
      "test health|cfr|sngate|causal|trust|dht|all",
      "bench <n>", "watch [sig]", "clear", "exit"
    ]
  },
  "unload_policy": {
    "vital_modules": ["bridge-identity","bridge-core","bridge-IME","bridge-sngate","bridge-data","bridge-heartbeat","bridge-contracts"],
    "note": "Vital modules cannot be unloaded at runtime. All others can be unloaded via CLI or POST /module/:name/unload."
  }
}
